# Copy to .env.local for local overrides. Values here are placeholders or local synthetic-data
# development settings, never production credentials. Never prefix secrets with NEXT_PUBLIC_.

# --- Local development services (docker-compose.yml) ---
DATABASE_URL=postgresql://company_brain:company_brain_dev@127.0.0.1:5432/company_brain
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH_PREFIX=company_brain

# --- Model provider (server-side only; used by later milestones and `pnpm check:provider`) ---
# OPENAI_AUTH_MODE is this application's setting, not an OpenAI option. Exactly one of:
#   network_secret  Claude Code cloud: a network secret attaches Authorization to api.openai.com;
#                   OPENAI_API_KEY stays unset. The value of this variable is the literal word.
#   api_key         Ordinary hosting: the server reads OPENAI_API_KEY.
OPENAI_AUTH_MODE=network_secret
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Model IDs are recorded only after `pnpm check:provider` verifies access. Unverified candidates:
OPENAI_TEXT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=
