{
  "name": "company-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "db:up": "docker compose up -d --wait postgres falkordb",
    "db:down": "docker compose stop postgres falkordb",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "check:services": "tsx scripts/check-services.ts",
    "check:provider": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 tsx scripts/check-provider.ts",
    "bootstrap": "bash scripts/dev-bootstrap.sh",
    "check": "bash scripts/dev-check.sh"
  },
  "dependencies": {
    "falkordb": "6.8.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
